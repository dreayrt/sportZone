# Merge these lines into the existing .env; do not overwrite your DB/auth configuration.
VENUE_CACHE_STORE=file
VENUE_CACHE_SECONDS=60
# To use Redis: VENUE_CACHE_STORE=redis, configure existing REDIS_* variables
# and enable the PHP Redis extension. No changes to global CACHE_STORE are required.
GOOGLE_MAPS_SERVER_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
