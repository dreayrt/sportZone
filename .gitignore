# ==========================================
# SportZone - Root Git Ignore Configuration
# ==========================================

# Environment & Sensitive Files
.env
.env.*
.env.backup
.env.production
*.env
!.env.example
!.env.*.example

# Dependencies
node_modules/
**/node_modules/
vendor/
**/vendor/

# Next.js & Frontend Build Outputs
.next/
**/.next/
out/
build/
dist/
*.tsbuildinfo

# Laravel Framework & Storage
backend/storage/*.key
backend/storage/pail
backend/storage/framework/cache/data/*
!backend/storage/framework/cache/data/.gitignore
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitignore
backend/storage/framework/testing/*
!backend/storage/framework/testing/.gitignore
backend/storage/framework/views/*
!backend/storage/framework/views/.gitignore
backend/storage/logs/*
!backend/storage/logs/.gitignore
backend/bootstrap/cache/*
!backend/bootstrap/cache/.gitignore
backend/public/storage
backend/public/hot
backend/public/build
_ide_helper.php
.phpunit.result.cache
Homestead.json
Homestead.yaml

# Logs & Debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating System & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.agents/
.gemini/
